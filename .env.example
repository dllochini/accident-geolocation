# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps API (uncomment when implementing map view)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here

# Authentication Provider
# Options: 'mock' (development), 'fastapi' (production)
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Feature Flags
NEXT_PUBLIC_ENABLE_MAP_VIEW=false
NEXT_PUBLIC_ENABLE_EXPORT=false
NEXT_PUBLIC_ENABLE_COLLABORATION=false

# App Configuration
NEXT_PUBLIC_APP_NAME=AccidentGeo
NEXT_PUBLIC_APP_VERSION=0.1.0

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# Error Tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=
